## Production binding: only this configured public origin is accepted for lead submissions.
## Use NODE_ENV=development only for a same-origin localhost/127.0.0.1 preview.
NODE_ENV=production
PUBLIC_SITE_URL=https://dnk.batoohan.ru
SITE_AUTHOR_FULL_NAME=
SMTP_HOST=
SMTP_PORT=
# true: implicit TLS on connect (typically port 465).
# false: STARTTLS upgrade; the production transport requires that upgrade and rejects plaintext SMTP.
# TLS certificate validation is always enabled and cannot be disabled by this file.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_RECIPIENT_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
TELEGRAM_BOT_TOKEN=
# Public username only (without @); this is not a bot token.
TELEGRAM_BOT_USERNAME=DandK_FitBody_bot
TELEGRAM_WEBHOOK_SECRET=
REDIS_URL=
PII_HASH_SECRET=
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_CONTACT=
